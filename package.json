{
  "name": "leaguelive",
  "version": "1.0.0",
  "private": true,
  "description": "LeagueLive — a lightweight, Fotmob-style football livescore & league table app with an admin backend.",
  "main": "server/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
