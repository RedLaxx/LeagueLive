# Copy to .env or export in your shell before `npm start`.

# Port / bind address
PORT=3000
HOST=0.0.0.0

# Admin panel password (default: leaguelive)
ADMIN_PASSWORD=leaguelive

# Allow the admin panel to export + commit + push to git (0 = off, 1 = on)
ENABLE_GIT_PUBLISH=0

# Rebuild the static snapshot automatically after every admin change (0/1)
AUTO_EXPORT=1

# Where the database lives
# LEAGUELIVE_DATA=./data
# LEAGUELIVE_DB=./data/leaguelive.db
